# Copy this file to .env.local and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Without these two vars,
# VIBEU runs in "demo mode": Library/Blog/Community show the built-in seed
# content, and login, posting, and /admin are disabled with a clear notice.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
