# Copy this file to .env.local and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Without these two vars,
# VIBEU runs in "demo mode": Library/Blog/Community show the built-in seed
# content, and login, posting, and /admin are disabled with a clear notice.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Cloudflare Turnstile site key (dashboard.cloudflare.com -> Turnstile -> Add site).
# Without it, sign-up/sign-in simply render without a captcha widget. To make it actually block
# bots you must also paste the matching Turnstile SECRET key into Supabase Dashboard ->
# Authentication -> Attack Protection -> Enable CAPTCHA protection.
VITE_TURNSTILE_SITE_KEY=

# Optional: Google Analytics 4 Measurement ID (analytics.google.com -> Admin -> Data Streams ->
# your web stream -> "G-XXXXXXX"). Without it, index.html's gtag snippet stays completely inert
# (no script loads, no request fires) — see index.html.
VITE_GA_MEASUREMENT_ID=

# Optional: Google Search Console's HTML-tag verification code (search.google.com/search-console
# -> Add property -> vibeu.design -> HTML tag method -> copy just the `content="..."` value, not
# the whole <meta> tag). Without it, the meta tag ships with an empty content attribute — harmless.
VITE_GSC_VERIFICATION=
